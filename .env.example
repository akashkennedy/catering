# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Never expose DATABASE_URL to the browser.

# CRM login (server-only). AUTH_USERNAME/AUTH_PASSWORD are the pre-database
# fallback only; once Neon is migrated, logins come from the users table.
AUTH_SESSION_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD=

# First admin account, consumed only by `npm run db:seed-admin` (never by the app).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Neon Postgres pooled connection string (server-only, used by /api/site-content).
# Neon dashboard → Connect → pooled connection.
DATABASE_URL=

# Instant website refresh after Publish.
# Landing hook: POST $SITE_PUBLISH_URL with header `Authorization: Bearer $PUBLISH_SECRET`
# and NO body. Treat HTTP 200 + {"ok":true} as success; 401 means the secret is wrong.
# Read the value from Vercel (landing project env `PUBLISH_SECRET`) — never commit it.
SITE_PUBLISH_URL=https://mampallicatering.vercel.app/api/publish
PUBLISH_SECRET=
# Legacy aliases (still honored as fallback):
# SITE_REVALIDATE_URL=
# SITE_REVALIDATE_SECRET=
